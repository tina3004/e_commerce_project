<%- include('./partials/header') %>
<div class="w-full px-20 py-20">
    <div class="flex justify-between items-start gap-10">
        <!-- Left Section: Image + Price Breakdown -->
        <div class="w-[70%] flex flex-col gap-10">
            <%if(user.cart.length>0){%>
                <% user.cart.forEach(function(item){ %>
                    <div class="w-full flex items-start gap-10 p-5 rounded-md">
                        <!-- Image Section -->
                        <div class="w-[30%] rounded-md overflow-hidden">                    
                            <div class="w-full h-60 flex justify-center items-center [<%=item.bgcolor%>]">
                                <img class="w-full h-[15rem]" src="data:image/jpeg;base64, <%= item.image.toString('base64') %>" alt="">
                            </div>
                            <div class="w-full flex justify-between px-5 py-4 bg-[<%=item.panelcolor%>]">
                                <h3 class="text-2xl font-bold"><%= item.name %></h3>
                            </div>   
                        </div>
                        

                        <!-- Price Breakdown Section -->
                        <div class="w-[70%]">
                            <div class="flex justify-between items-center">
                                <h3 class="text-xl font-bold">Price Breakdown</h3>
                                <a class="text-red-600" href="/remove-from-cart/<%= item._id%>">Remove from cart</a>
                            </div>
                            
                            <div class="px-5 mt-5">
                                <div class="flex justify-between mt-2">
                                    <h4>Total MRP</h4>
                                    <h4>₹ <%= item.price %></h4>
                                </div>
                                <div class="flex justify-between mt-2">
                                    <h4>Discount on MRP</h4>
                                    <h4>-₹ <%= item.discount %></h4>
                                </div>
                                <!-- <div class="flex justify-between mt-2">
                                    <h4>Platform Fee</h4>
                                    <h4>₹ 20</h4>
                                </div> 
                                <div class="flex justify-between mt-2">
                                    <h4>Shipping Fee</h4>
                                    <h4>FREE</h4>
                                </div>-->
                                <div class="flex justify-between mt-2">
                                    <h4>Subtotal</h4>
                                    <h4>₹ <%=item.price- item.discount %></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% }else{%>
                <div class="text-center text-xl font-bold text-gray-600">
                    <p>There are no items in your cart.</p>
                </div>
            <% } %>
        </div>

        <!-- Vertical Line Divider -->
        <% if (user.cart.length > 0) { %>
            <div class="w-[1px] bg-black self-stretch"></div>
        <% } %>

        <!-- Right Section: Total Amount -->
        <div class="w-[30%] p-5 rounded-md">
            <%if(user.cart.length>0){%>
            <h2 class="text-2xl font-bold">Total Amount</h2>
            <div class="mt-5 flex flex-col gap-2">
                <p class="flex justify-between">
                    <span>Total Items:</span>
                    <span><%= user.cart.length %></span>
                </p>
                <p class="flex justify-between">
                    <span>Total MRP:</span>
                    <span>₹ <%= amt %></span>
                </p>
                <p class="flex justify-between">
                    <span>Discount:</span>
                    <!-- <span>-₹ <%= user.cart.reduce((acc, item) => acc + item.discount, 0) %></span> -->
                    <span>-₹<%=amt-finalamt%> </span>
                </p>
                <p class="flex justify-between">
                    <span>Platform Fee:</span>
                    <span>₹ 20</span>
                </p>
                <p class="flex justify-between text-xl font-semibold">
                    <span>Grand Total:</span>
                    <span>₹ <%= finalamt +20 %></span>
                </p>
            </div>
            <%}%>
        </div>
    </div>
</div>
<%- include('./partials/footer') %>
