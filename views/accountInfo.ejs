<%- include('./partials/header') %>

<div class="p-20">
    <!-- Profile Header -->
    <div class="flex items-center gap-5">
        <img class="h-24 w-24" src="/images/default_prof_pic.jpeg" alt="Profile Picture">
        <h3 class="text-3xl font-bold">Your Account</h3>
        <h6>Hi, <%=user.firstName%> </h6>
    </div>

    <!-- Profile Details -->
    <div class="mt-10">
        <h2 class="text-2xl font-bold mb-6">Profile Details</h2>
        
        <!-- Full Name -->
        <div class="flex gap-10">
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2">First Name</label>
                <input 
                    class="p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" 
                    type="text" 
                    value="<%=user.firstName%>"
                >
            </div>
    
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2">Last Name</label>
                <input 
                    class="p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" 
                    type="text" 
                    value="<%=user.lastName%>"
                >
            </div>
        </div>
        

        <!-- Email --><!-- Contact -->

        <div class="flex gap-10">
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2">Email</label>
                <input 
                    class="p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" 
                    type="text" 
                    value="<%=user.email%>"
                >
            </div>
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Contact</label>
                <input 
                    class=" p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" 
                    type="text" 
                    value="<%=user.contact%>"
                >
            </div>
        </div>
        
    </div>
</div>

<%- include('./partials/footer') %>
